# Backend (copy to backend/.env for local development)
DATABASE_URL=sqlite:///./data/leadflow.db
# Production (Neon): use the pooled string for the deployed API, the direct string for alembic/seed
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# Optional: run the API tests against Postgres instead of in-memory SQLite
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/leadflow_test
CORS_ORIGINS=["http://localhost:3000"]

# Frontend (shell env or frontend/.env.local): where the Next.js proxy forwards /api
API_INTERNAL_URL=http://localhost:8000
